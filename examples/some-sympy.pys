from sympy import *

a, b, c, d, w, x, y, z = symbols('a b c d w x y z')

func solveit(ex, finds) print(solve(ex, finds))

ex1 = Eq(x - 5, 0)
solveit(ex1, x)

ex2 = Eq(2*x**2 - 4*x + 1, 0)
solveit(ex2, x)

ex3 = Eq(x**3 + 3*x**2 - 6*x - 18, 0)
solveit(ex3, x)

ex4 = limit(a*x**(1/a) - a, a, oo)
print(ex4)

ex5 = integrate(S(1)/3 * x**3)
print(ex5)

K = Matrix([
    [3, -1, -1],
    [2, 2, 1],
    [1, 1, -2]
])
B = Matrix([
    [6],
    [7],
    [-9]
])

print(K**-1 * B)
print(K.solve(B))

f1 = Lambda(x, (exp(x*I) - exp(-x*I))/(2*I))
print(f1(pi/2))

f2 = Lambda(x, 2*x - 5)
inv_f2 = solve(Eq(f2(y), x), y)[0]
inv_f2 = Lambda(x, inv_f2)
print(inv_f2)