# My old Tetris project (converted to PyScript language)
# Only works in PyScript>=1.15.0.dev1

from __future__ import dict2jsdict

from os import urandom
from jsdict import jsdict
from itertools import product
from fpstimer import fpstimer
from ansi import acolor, ahtml
from random import seed, choice
from getch import init, quit, kbhit, getach

import sys

TICK_FRAME = 24
FALL_INTERVAL = 0.5
SHADOW_LEVEL = 75
EMPTY_STRING = ' .'
GRID_STRING = '[]'
SHADOW_STRING = '//'

SHAPES = [
    {
        name: 'S',
        color: (0, 255, 0),
        array: [
            [
                '     ',
                '     ',
                '  XX ',
                ' XX  ',
                '     '
            ],
            [
                '     ',
                '  X  ',
                '  XX ',
                '   X ',
                '     '
            ]
        ]
    },
    {
        name: 'Z',
        color: (255, 0, 0),
        array: [
            [
                '     ',
                '     ',
                ' XX  ',
                '  XX ',
                '     '
            ],
            [
                '     ',
                '  X  ',
                ' XX  ',
                ' X   ',
                '     '
            ]
        ]
    },
    {
        name: 'I',
        color: (0, 255, 255),
        array: [
            [
                '  X  ',
                '  X  ',
                '  X  ',
                '  X  ',
                '     '
            ],
            [
                '     ',
                'XXXX ',
                '     ',
                '     ',
                '     '
            ]
        ]
    },
    {
        name: 'O',
        color: (255, 255, 0),
        array: [
            [
                '     ',
                '     ',
                ' XX  ',
                ' XX  ',
                '     '
            ]
        ]
    },
    {
        name: 'J',
        color: (255, 165, 0),
        array: [
            [
                '     ',
                ' X   ',
                ' XXX ',
                '     ',
                '     '
            ],
            [
                '     ',
                '  XX ',
                '  X  ',
                '  X  ',
                '     '
            ],
            [
                '     ',
                '     ',
                ' XXX ',
                '   X ',
                '     '
            ],
            [
                '     ',
                '  X  ',
                '  X  ',
                ' XX  ',
                '     '
            ]
        ]
    },
    {
        name: 'L',
        color: (0, 0, 255),
        array: [
            [
                '     ',
                '   X ',
                ' XXX ',
                '     ',
                '     '
            ],
            [
                '     ',
                '  X  ',
                '  X  ',
                '  XX ',
                '     '
            ],
            [
                '     ',
