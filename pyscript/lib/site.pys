import os
import sys
import explorer

from '_pyscript>utils>module' import get_module_candidate
from '_pyscript>utils>path' import normpath

(func getusersitepackages() {
    global ENABLE_USER_SITE
    path = sys.site_packages_path
    ENABLE_USER_SITE = path is not none
    return path
})()

func removeduppaths() {
    path = []
    known_paths = set()

    for (directory of sys.path) {
        directory = normpath(directory)
        if (directory not in known_paths) {
            path.append(directory)
            known_paths.add(directory)
        }
    }

    sys.path[:] = path
    return known_paths
}

func getsitepackages() {
    site_path = getusersitepackages()
    if (!ENABLE_USER_SITE)
        throw Exception('user site is disabled')
    return list(comprehension(
        os.listdir(site_path),
        func(package) => os.path.splitext(package)[0],
        func(package) => get_module_candidate(normpath(site_path, package)) is not none
    ))
}

func addpackage(path) {
    site_path = getusersitepackages()
    if (!ENABLE_USER_SITE)
        throw Exception('user site is disabled')
    if (get_module_candidate(normpath(path)) is none)
        throw ModuleNotFoundError("invalid module")
    result = explorer.copy(path, site_path, metadata=False)
    if (!result.success)
        throw result.exception
}

func removepackage(name) {
    site_path = getusersitepackages()
    if (!ENABLE_USER_SITE)
        throw Exception('user site is disabled')
    path = normpath(site_path, name)
    if (get_module_candidate(path) is none)
        throw ModuleNotFoundError("module not found")
    if (!os.path.exists(path))
        path += '.pys'
    result = explorer.remove(path)
    if (!result.success)
        throw result.exception
}

__all__ = (
    'removeduppaths',
    'getusersitepackages',
    'getsitepackages',
    'addpackage',
    'removepackage'
)

if (__name__ == '__main__') {
    import argparse

    parser = argparse.ArgumentParser(
        prog="{} -m site".format(sys.executable),
        description="PyScript's site module"
    )

    parser.add_argument(
        '--user-site',
        action='store_true',
        help='show the user site path'
    )

    parser.add_argument(
        '-s',
        action='store_true',
        help="dont show any information, just do it"
    )

    parser.add_argument(
        '-l',
        action='store_true',
        help='get the list of site packages'
    )

    parser.add_argument(
        '-a',
        metavar='PATH',
        help='add a package to site packages'
    )

    parser.add_argument(
        '-r',
        metavar='NAME',
        help='remove a package from site packages'
    )

    args = parser.parse_args(sys.argv[1:])

    if (args.s) {
        func info(message);
        func error(message)
            sys.exit(1)
    } else {
        func info(message)
            print(message)
        func error(message) {
            print(message, file=sys.stderr)
            sys.exit(1)
        }
    }

    if (args.user_site)
        print(getusersitepackages())

    elif (!ENABLE_USER_SITE)
        error('User site is disabled')

    elif (args.l)
        print('\n'.join(sorted(getsitepackages())))

    elif (args.a)
        try {
            addpackage(args.a)
            info('Package added successfully')
        } catch (e)
            error('-a: {}: {}'.format(typeof e, e))

    elif (args.r)
        try {
            removepackage(args.r)
            info('Package removed successfully')
        } catch (e)
            error('-r: {}: {}'.format(typeof e, e))

    else
        parser.print_help(sys.stdout)
}