from _pyscript import shell

if (shell.ADVANCE_LINE_SHELL_SUPPORT) {
    HISTORY_PATH = shell.HISTORY_PATH
    HISTORY_LIMIT = shell.HISTORY_LIMIT

    func load() => shell.history.get_strings()
    func append(string) shell.history.append_string(string)

    if (shell.USE_FILE_HISTORY) {
        import explorer
        func clear() {
            shell.history._loaded_strings.clear()
            explorer.clear(HISTORY_PATH)
        }
    } else {
        func clear() {
            shell.history._loaded_strings.clear()
            shell.history._storage.clear()
        }
    }

} else {
    HISTORY_PATH = '<none>'
    HISTORY_LIMIT = 1024

    func load() => []
    func append(string);
    func clear();
}

__all__ = (
    'HISTORY_PATH',
    'HISTORY_LIMIT',
    'load',
    'append',
    'clear'
)